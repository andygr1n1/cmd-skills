#!/usr/bin/env bash
# Download a Facebook video or reel as MP4 into ~/Videos/Facebook.
# Usage:
#   fb URL
#   fb --cookies=chrome URL

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: fb [--cookies=BROWSER] URL

  URL                 Facebook video, reel, or fb.watch URL
  --cookies=BROWSER   Read cookies from a logged-in browser (chrome, firefox, ...)
                      Public reels often work without this. Login-only videos do not.
EOF
  exit 1
}

cookies=""
url=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cookies=*)
      cookies="${1#--cookies=}"
      shift
      ;;
    --cookies)
      cookies="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown argument: $1" >&2
      usage
      ;;
    *)
      if [[ -n "$url" ]]; then
        echo "Error: only one URL is allowed" >&2
        usage
      fi
      url="$1"
      shift
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  if [[ -n "$url" || $# -ne 1 ]]; then
    echo "Error: only one URL is allowed" >&2
    usage
  fi
  url="$1"
fi

if [[ -z "$url" ]]; then
  usage
fi

if [[ ! "$url" =~ ^https?://([^/?#]+\.)?(facebook\.com|fb\.com|fb\.watch)(/|$|\?) ]]; then
  echo "Error: URL must be a facebook.com, fb.com, or fb.watch link" >&2
  exit 1
fi

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "Error: yt-dlp is not on PATH" >&2
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "Error: ffmpeg is not on PATH" >&2
  exit 1
fi

mkdir -p "$HOME/Videos/Facebook"

args=(
  -f "bv*+ba/b"
  --merge-output-format mp4
  --embed-metadata
  --no-playlist
  -o "$HOME/Videos/Facebook/%(uploader)s - %(title).80s [%(id)s].%(ext)s"
)

if [[ -n "$cookies" ]]; then
  args+=(--cookies-from-browser "$cookies")
fi

yt-dlp "${args[@]}" "$url"
